rules_version = '2';
// Alex_bes😈 — правила Firestore. Публікуються вручну: Firebase Console → Firestore Database → Rules.
service cloud.firestore {
  match /databases/{database}/documents {

    // Єдиний адміністратор: besspikk@gmail.com з підтвердженим email
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'besspikk@gmail.com'
        && request.auth.token.email_verified == true;
    }
    function optStr(d, k, n) { return !(k in d) || (d[k] is string && d[k].size() <= n); }
    function optNum(d, k)    { return !(k in d) || d[k] == null || d[k] is number; }
    function optBool(d, k)   { return !(k in d) || d[k] is bool; }
    function optList(d, k, n){ return !(k in d) || d[k] == null || (d[k] is list && d[k].size() <= n); }

    // Товари: публічне читання; запис — лише адмін
    match /products/{id} {
      allow read: if true;
      allow delete: if isAdmin();
      allow create, update: if isAdmin()
        && id.matches('^[A-Za-z0-9_-]{1,80}$')
        && request.resource.data.keys().hasOnly(['name', 'category', 'price_eur', 'price_old_eur', 'price_label', 'in_stock',
             'description', 'promo', 'variants', 'code', 'brand', 'hidden', 'hasPhoto', 'custom', 'createdAt', 'updatedAt',
             'gallery', 'videos'])
        && optStr(request.resource.data, 'name', 300)
        && optStr(request.resource.data, 'category', 60)
        && optNum(request.resource.data, 'price_eur')
        && optNum(request.resource.data, 'price_old_eur')   // 08.10: стара (перекреслена) ціна, € (null = без знижки)
        && optStr(request.resource.data, 'price_label', 120)
        && optStr(request.resource.data, 'in_stock', 120)
        && optStr(request.resource.data, 'description', 6000)
        && optStr(request.resource.data, 'promo', 20)
        && optList(request.resource.data, 'variants', 40)
        && optStr(request.resource.data, 'code', 120)
        && optStr(request.resource.data, 'brand', 120)
        && optBool(request.resource.data, 'hidden')
        && optBool(request.resource.data, 'hasPhoto')
        && optBool(request.resource.data, 'custom')
        && optList(request.resource.data, 'gallery', 11)   // порядок фото: 'static' | 'main' | ключ додаткового фото
        && optList(request.resource.data, 'videos', 5);    // посилання на TikTok / YouTube / Instagram
    }

    // Фото товарів (data URL у Firestore, бо Storage недоступний на Spark): photos/{id} — головне, photos/{id}__{ключ} — додаткові.
    // Публічне читання; запис — лише адмін
    match /photos/{id} {
      allow read: if true;
      allow delete: if isAdmin();
      allow create, update: if isAdmin()
        && id.matches('^[A-Za-z0-9_-]{1,130}$')
        && request.resource.data.keys().hasOnly(['data', 'updatedAt'])
        && request.resource.data.data is string
        && request.resource.data.data.matches('^data:image/(webp|jpeg|png);base64,.*')
        && request.resource.data.data.size() <= 1000000;
    }

    // Профіль, кошик і фото профілю покупця: лише власник (адмін може читати)
    match /users/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'phone', 'city', 'np', 'email', 'cart', 'photo', 'updatedAt'])
        && optStr(request.resource.data, 'name', 100)
        && optStr(request.resource.data, 'phone', 40)
        && optStr(request.resource.data, 'city', 120)
        && optStr(request.resource.data, 'np', 120)
        && optStr(request.resource.data, 'email', 200)
        && optNum(request.resource.data, 'updatedAt')
        // фото профілю (js/fb.js): data URL webp/jpeg, ≤ 256×256, стиснуте на пристрої (≈10–40 КБ; ліміт 180 000 символів)
        && (!('photo' in request.resource.data) || (request.resource.data.photo is string
             && request.resource.data.photo.size() <= 180000
             && request.resource.data.photo.matches('^data:image/(webp|jpeg);base64,[A-Za-z0-9+/=]+$')))
        && (!('cart' in request.resource.data) || (request.resource.data.cart is list && request.resource.data.cart.size() <= 200));
    }

    // Замовлення з кошика сайту для Telegram-бота: orders/{20 випадкових символів [A-Za-z0-9]}.
    // Створити може будь-хто (без входу), але лише за суворою схемою й з обмеженням розміру (документ ≤ ~25 КБ).
    // items — JSON-рядок [{id,name,variant,qty,price_uah}, …] (не масив: перевірка кожного елемента масиву
    // в правилах впирається в ліміт 1000 виразів уже на ~5 позиціях; структуру перевіряє бот).
    // Прочитати — лише знаючи id (get); перелік (list), зміна статусу й видалення — лише адмін.
    // status: 'new' | 'confirmed' | 'shipped' | 'paid' | 'cancelled' (при створенні — відсутній або 'new').
    function ORDER_STATUSES() { return ['new', 'confirmed', 'shipped', 'paid', 'cancelled']; }
    function optInt(d, k, max) { return !(k in d) || (d[k] is int && d[k] >= 0 && d[k] <= max); }
    function isOrderNotifier() { return request.auth != null && request.auth.uid == 'eTCoRutzpJVpPKv9yGViPYwOpI03'; }
    match /orders/{id} {
      allow get: if id.matches('^[A-Za-z0-9]{20}$');
      allow list: if isAdmin() || isOrderNotifier();
      allow delete: if isAdmin();
      // адмінка: змінювати можна лише статус (з дозволеного набору) і час зміни (серверний)
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.status in ORDER_STATUSES()
        && request.resource.data.updatedAt == request.time;
      allow create: if id.matches('^[A-Za-z0-9]{20}$')
        && request.resource.data.keys().hasAll(['v', 'items', 'createdAt'])
        && request.resource.data.keys().hasOnly(['v', 'items', 'count', 'total_uah', 'ask', 'text',
             'name', 'phone', 'city', 'note', 'createdAt', 'status'])
        && request.resource.data.v == 1
        && (!('status' in request.resource.data) || request.resource.data.status == 'new')
        && request.resource.data.items is string
        && request.resource.data.items.size() <= 15000
        && request.resource.data.items.matches('^\\[\\{.*\\}\\]$')
        && optInt(request.resource.data, 'count', 500)
        && optInt(request.resource.data, 'total_uah', 1000000000)
        && optInt(request.resource.data, 'ask', 500)
        && optStr(request.resource.data, 'text', 6000)
        && optStr(request.resource.data, 'name', 100)
        && optStr(request.resource.data, 'phone', 40)
        && optStr(request.resource.data, 'city', 200)
        && optStr(request.resource.data, 'note', 1000)
        && request.resource.data.createdAt == request.time;   // serverTimestamp(): час ставить сервер
    }

    // Статистика сайту (без cookies й персональних даних): stats/{YYYY-MM-DD за Києвом} — денні лічильники.
    // Поля: views (візити), cart (додавання в кошик), o_<канал> (кліки «замовити»: bot, botp, tg, wa, viber, ig, call, consult),
    // p_<id товару> (відкриття картки). Кожен запис сайту — рівно +1 до ОДНОГО поля (increment), назва поля дублюється в k.
    // Публіка не читає; читати й видаляти — лише адмін. День — лише поточний (±1 доба на часові пояси).
    function statKey(k) {
      return k is string && k.matches('^(views|cart|o_(bot|botp|tg|wa|viber|ig|call|consult)|p_[A-Za-z0-9_-]{1,80})$');
    }
    function statDay(day) {
      return day.matches('^20[0-9]{2}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$')
        && request.time > timestamp.date(int(day[0:4]), int(day[5:7]), int(day[8:10])) - duration.value(1, 'd')
        && request.time < timestamp.date(int(day[0:4]), int(day[5:7]), int(day[8:10])) + duration.value(2, 'd');
    }
    match /stats/{day} {
      allow get, list, delete: if isAdmin();
      allow create: if statDay(day)
        && statKey(request.resource.data.k)
        && request.resource.data.keys().hasOnly(['k', request.resource.data.k])
        && request.resource.data[request.resource.data.k] == 1;
      allow update: if statDay(day)
        && statKey(request.resource.data.k)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['k', request.resource.data.k])
        && request.resource.data.diff(resource.data).affectedKeys().hasAll([request.resource.data.k])
        && request.resource.data[request.resource.data.k] == resource.data.get(request.resource.data.k, 0) + 1;
    }

    // 08.10.2026: що додають у кошик (адмінка → «Статистика» → «Що додають у кошик»): cart_events/{авто-id}.
    // Створити може будь-хто (і гість) — лише за суворою схемою й з обмеженням розмірів; змінити чи видалити — ніхто;
    // читати — лише адмін. uid/email — тільки власні (з токена входу); гість: uid = '', email = '', who = 'Гість'.
    // dev — анонімний id пристрою (16 символів [a-z0-9]); ts — лише серверний час (serverTimestamp()).
    function cartEventOk(d) {
      return d.keys().hasOnly(['pid', 'name', 'vi', 'variant', 'qty', 'price', 'old', 'sec', 'page', 'uid', 'who', 'email', 'dev', 'ts'])
        && d.keys().hasAll(['pid', 'name', 'vi', 'qty', 'sec', 'uid', 'who', 'dev', 'ts'])
        && d.pid is string && d.pid.matches('^[A-Za-z0-9_-]{1,80}$')
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 200
        && d.vi is int && d.vi >= 0 && d.vi <= 199
        && optStr(d, 'variant', 100)
        && d.qty is int && d.qty >= 1 && d.qty <= 999
        && (!('price' in d) || d.price == null || (d.price is int && d.price >= 0 && d.price <= 10000000))
        && (!('old' in d) || d.old == null || (d.old is int && d.old >= 0 && d.old <= 10000000))
        && d.sec is string && d.sec.size() >= 1 && d.sec.size() <= 80
        && optStr(d, 'page', 120)
        && d.dev is string && d.dev.matches('^[a-z0-9]{16}$')
        && d.who is string && d.who.size() <= 100
        && optStr(d, 'email', 200)
        && ((request.auth == null && d.uid == '' && d.who == 'Гість' && d.get('email', '') == '')
            || (request.auth != null && d.uid == request.auth.uid
                && (d.get('email', '') == '' || d.get('email', '') == request.auth.token.get('email', ''))))
        && d.ts == request.time;
    }
    match /cart_events/{id} {
      allow get, list: if isAdmin();
      allow create: if cartEventOk(request.resource.data);
    }

    // Усе інше заборонено
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
